    "conversion.mode.strict_description": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Strict allows only Exact and Equivalent plans; any L2+ fallback blocks before writing."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "严格模式仅允许精确保留或语义等效方案；任何 L2 及以上回退都会在写入前阻止转换。"}}}},
    "conversion.mode.compatible_description": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Compatible is the default: preserve semantics and layout, with an explicit verified fallback when needed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "兼容模式为默认模式：保留语义与版式，必要时采用明确且经过验证的回退。"}}}},
    "conversion.mode.readable_description": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Readable prioritizes a usable document; every approximation or dropped feature remains in the report."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "可读模式优先保证文档可用；所有近似处理或舍弃的特性都会保留在报告中。"}}}},
    "conversion.batch.best_effort_description": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Best effort continues other files when one source or target fails."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "尽力模式在某个来源或目标失败时仍继续处理其他文件。"}}}},
    "conversion.output.folder": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "FolioForge-output beside selected folder"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "所选文件夹旁的 FolioForge-output 文件夹"}}}},
    "conversion.output.same_folder": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Same folder as input"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "与输入文件位于同一文件夹"}}}},
