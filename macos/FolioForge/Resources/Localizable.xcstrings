    "online.search_book_metadata": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Search Book Metadata"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "搜索书籍元数据"}}}},
    "online.no_matching_message": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "No records matched these terms. Try a shorter title or a different identifier."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "没有与这些条件匹配的记录。请尝试缩短书名或更换标识符。"}}}},
    "online.search_manual_opt_in": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Search is manual and opt-in. Results are never applied automatically."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "搜索由用户手动发起。结果不会自动应用。"}}}},
    "online.select_result": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Select a Result"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择一条结果"}}}},
    "online.choose_candidate": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose a candidate to review its fields."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择一个候选项以查看其字段。"}}}},
